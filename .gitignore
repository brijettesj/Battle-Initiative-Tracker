# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Scratch
*.bak
*.tmp

# Node
node_modules/

# Build output — regenerated by `npm run build`
www/

# The ios/ and android/ folders are deliberately NOT ignored. They hold the
# app icon, the version numbers and the store configuration, and every update
# has to build on what was shipped last time. Capacitor writes its own
# .gitignore inside each one covering the genuinely disposable parts.
.gradle/

# Signing material must never be committed. Losing it is bad; leaking it is
# worse, because anyone holding it can publish an update as you.
*.jks
*.keystore
*.p12
*.mobileprovision
key.properties
local.properties

# Local toolchain, downloaded not authored (Temurin JDK 21)
tools/
